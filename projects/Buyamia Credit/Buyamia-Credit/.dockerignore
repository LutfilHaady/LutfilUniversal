# .dockerignore for Next.js Web Application

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next
out
build
dist

# Environment files
.env
.env*.local
.env.production

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Testing
coverage
.nyc_output

# Misc
*.log
*.md
!.github/**/*.md

# Python (for agent)
livekit-agent/__pycache__
livekit-agent/venv
livekit-agent/.venv
livekit-agent/*.pyc
livekit-agent/*.pyo

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore
