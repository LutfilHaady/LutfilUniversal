{
  "manifest_version": 3,
  "name": "VOX Guard: Story Monitor",
  "version": "1.0",
  "description": "A privacy-conscious overlay for monitoring Instagram Stories.",
  "permissions": ["activeTab", "scripting","storage"],
  "host_permissions": ["*://*.instagram.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VOX Guard"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}
